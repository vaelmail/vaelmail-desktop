{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaelMail",
  "version": "0.2.1",
  "identifier": "com.vaelmail.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "VaelMail",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#101716",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "freezePrototype": false,
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: vaelapi: http://vaelapi.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src vaelframe: http://vaelframe.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Privacy-first email",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "languages": ["English"],
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "VaelMail",
    "homepage": "https://vaelmail.com",
    "copyright": "VaelMail"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mailto"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyRDhGNjk5NEM2MDM2MTAKUldRUU5tQk1tZmJZNHZnV2l4blo3TEZvQUNDZDFzaUtXV1VqQW9MQlRJL1I1TUFpSXJYY2txakoK",
      "endpoints": [
        "https://github.com/vaelmail/vaelmail-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
