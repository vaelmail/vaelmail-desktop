{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaelMail Setup",
  "version": "0.2.0",
  "identifier": "com.vaelmail.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "setup",
        "title": "VaelMail Setup",
        "width": 860,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#101716",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Installs VaelMail",
    "icon": [
      "../src-tauri/icons/32x32.png",
      "../src-tauri/icons/128x128.png",
      "../src-tauri/icons/128x128@2x.png",
      "../src-tauri/icons/icon.icns",
      "../src-tauri/icons/icon.ico"
    ],
    "publisher": "VaelMail",
    "homepage": "https://vaelmail.com",
    "copyright": "VaelMail",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
